{
  "variables": {
    "vm_name": "x07-container-escape-base",
    "iso_url": "https://releases.ubuntu.com/22.04/ubuntu-22.04.3-live-server-amd64.iso",
    "iso_checksum": "sha256:a4acfda10b18da50e2ec50ccaf860d7f20b389df8765c37777073b7f1c1d484e"
  },
  "builders": [
    {
      "type": "qemu",
      "vm_name": "{{user `vm_name`}}.qcow2",
      "iso_url": "{{user `iso_url`}}",
      "iso_checksum": "{{user `iso_checksum`}}",
      "output_directory": "output-x07-image",
      "shutdown_command": "echo 'vagrant' | sudo -S shutdown -P now",
      "disk_size": "20480M",
      "format": "qcow2",
      "accelerator": "kvm",
      "http_directory": "http",
      "ssh_username": "vagrant",
      "ssh_password": "vagrant",
      "ssh_timeout": "20m",
      "cpus": 4,
      "memory": 4096,
      "net_device": "virtio-net",
      "disk_interface": "virtio",
      "boot_wait": "5s"
    }
  ],
  "provisioners": [
    {
      "type": "shell",
      "script": "provision_host.sh"
    }
  ]
}
